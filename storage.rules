rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function validId(id) { return id is string && id.matches('^[a-zA-Z0-9_-]{1,128}$'); }
    function activeMember(orgId) {
      let member = firestore.get(/databases/(default)/documents/memberships/$(orgId + '_' + request.auth.uid));
      return signedIn() && member.data.orgId == orgId
        && member.data.userId == request.auth.uid
        && member.data.status == 'ACTIVE';
    }
    function validCategory(category) {
      return category in ['audit-exports', 'incident-artifacts', 'remediation-manifests', 'cluster-snapshots', 'ai-diagnostics', 'user-uploads'];
    }
    function maxSize(category) {
      return (category == 'audit-exports' && request.resource.size <= 50 * 1024 * 1024)
        || (category == 'remediation-manifests' && request.resource.size <= 5 * 1024 * 1024)
        || (category == 'ai-diagnostics' && request.resource.size <= 10 * 1024 * 1024)
        || (category in ['incident-artifacts', 'cluster-snapshots', 'user-uploads'] && request.resource.size <= 25 * 1024 * 1024);
    }
    match /tenants/{orgId}/{category}/{path=**} {
      allow read: if validId(orgId) && validCategory(category) && activeMember(orgId);
      allow create: if validId(orgId) && validCategory(category) && activeMember(orgId)
        && request.resource.metadata.orgId == orgId
        && request.resource.metadata.category == category
        && maxSize(category)
        && request.resource.contentType.matches('^(application/json|text/csv|text/plain|application/x-yaml|text/yaml|application/pdf|image/png|image/jpeg|application/gzip|application/octet-stream)(;.*)?$');
      allow update: if validId(orgId) && validCategory(category) && category != 'audit-exports'
        && activeMember(orgId) && request.resource.metadata.orgId == orgId
        && request.resource.metadata.category == category && maxSize(category);
      allow delete: if validId(orgId) && validCategory(category) && category != 'audit-exports' && activeMember(orgId);
    }
    match /{path=**} { allow read, write: if false; }
  }
}
