rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsUser(uid) { return signedIn() && request.auth.uid == uid; }
    function validProfile(data) {
      return data.keys().hasOnly(['uid', 'email', 'fullName', 'organisationName', 'role', 'createdAt', 'updatedAt'])
        && data.uid == request.auth.uid
        && data.email is string
        && data.fullName is string;
    }

    // User profile is the only browser-accessible Firestore data. All control-plane
    // collections are accessed by the authenticated backend through Admin SDK.
    match /users/{uid} {
      allow read: if ownsUser(uid);
      allow create: if ownsUser(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if ownsUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'email', 'organisationName', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Organizations, memberships, clusters, incidents, remediations, audit,
    // billing, integrations, tokens, and telemetry are server-only.
    match /{document=**} { allow read, write: if false; }
  }
}
