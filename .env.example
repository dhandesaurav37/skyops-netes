# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / SKYOPS_API_URL: Publicly reachable URL for SkyOps SaaS Cloud API.
# Used by Kubernetes Agents to securely dispatch heartbeats, telemetry, and registration handshakes.
# Production must use the deployed HTTPS Cloud Run URL (not localhost).
# Example: https://ais-dev-jrvfxsw2z3hsomufnmypgw-811563557432.asia-southeast1.run.app
APP_URL="MY_APP_URL"
SKYOPS_API_URL=""

# Optional Client-Side Firebase Configuration Overrides
# Note: Firebase Web API keys are public client identifiers, not private backend secrets.
# Access control is enforced by Firebase Authentication and Firestore Security Rules.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
